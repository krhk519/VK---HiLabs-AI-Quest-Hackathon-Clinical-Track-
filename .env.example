# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

# Hugging Face token.
# - Not needed if the weights repo is public.
# - Needed (read token) if the weights repo is private, or to upload weights (write token).
# - Also raises download rate limits for the public base models (SapBERT, BioLORD, MedCPT).
HF_TOKEN=your_hf_token_here

# Hugging Face repo holding the saved weights (optional override; the default is set in scripts/download_weights.py).
HF_WEIGHTS_REPO=your-hf-username/your-repo-name

# Mistral La Plateforme key. Optional: used only for the LLM pick feature.
# Leave empty (or run with --no-llm) and nothing leaves the machine.
MISTRAL_API_KEY=your_mistral_key_here

# Optional path overrides
# HILABS_DATA_DIR=data
# HILABS_WORK_DIR=work
# HILABS_OUT_DIR=outputs
